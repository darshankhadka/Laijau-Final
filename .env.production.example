# ==============================================================================
# Laijau — Production Environment Configuration Template
# Copy this file to .env on the production host and fill in secrets
# Target Domain: https://laijau.com
# ==============================================================================

APP_NAME=Laijau
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kathmandu
APP_URL=https://laijau.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (MySQL 8.0 / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laijau
DB_USERNAME=laijau_dbuser
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Session Configuration (file or redis)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=laijau.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
Queue_CONNECTION=database

# Cache Configuration (file or redis)
CACHE_STORE=file
CACHE_PREFIX=laijau_cache_

# Backup & Disaster Recovery Encryption (Authenticated AES-256-GCM)
BACKUP_ENCRYPTION_KEY=your_backup_encryption_secret_key_here

# Redis Configuration (Optional, recommended for high concurrency)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration — Secure SSL/TLS via mail.laijau.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.laijau.com
MAIL_PORT=465
MAIL_USERNAME=info@laijau.com
MAIL_PASSWORD=YOUR_SECURE_MAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@laijau.com"
MAIL_FROM_NAME="Laijau"

# Incoming Mail Configuration (IMAP: 993, POP3: 995)
MAIL_INCOMING_HOST=mail.laijau.com
MAIL_IMAP_PORT=993
MAIL_POP3_PORT=995

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social Auth / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://laijau.com/auth/google/callback"

FRONTEND_URL=https://laijau.com
STOREFRONT_REVALIDATE_URL=none
STOREFRONT_REVALIDATE_SECRET=

# Logistics Providers (Nepal)
# Nepal Can Move (NCM)
NCM_MODE=sandbox
NCM_SANDBOX_URL=https://demo.nepalcanmove.com
NCM_PRODUCTION_URL=https://nepalcanmove.com
NCM_API_TOKEN=
NCM_DEFAULT_FROM_BRANCH=TINKUNE
NCM_WEBHOOK_SECRET=

# Pathao Courier
PATHAO_MODE=sandbox
PATHAO_SANDBOX_URL=https://courier-api-sandbox.pathao.com
PATHAO_PRODUCTION_URL=https://courier-api.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=

# Payment Gateways (Nepal)
# ConnectIPS
CONNECTIPS_MODE=sandbox
CONNECTIPS_SANDBOX_URL=https://uat.connectips.com
CONNECTIPS_PRODUCTION_URL=https://login.connectips.com
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=LAIJAU
CONNECTIPS_PASSWORD=
CONNECTIPS_CERT_PATH=/var/www/laijau/shared/certs/connectips.pfx
CONNECTIPS_CERT_PASSWORD=

# eSewa Manual QR Settings
ESEWA_ID=9801234567
ESEWA_ACCOUNT_NAME="Laijau Retail Pvt. Ltd."
